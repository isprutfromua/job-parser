# Required environment variables

# Telegram bot token (get from BotFather)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Telegram chat ID (where messages should be sent)
TELEGRAM_CHAT_ID=-1001234567890

# Optional environment variables

# Database path (default: ./data/job_parser.sqlite3)
# On Heroku, use DATABASE_URL for persistent database
JOB_PARSER_DB_PATH=./data/job_parser.sqlite3

# Scan interval in minutes (default: 120)
JOB_PARSER_INTERVAL_MINUTES=120
